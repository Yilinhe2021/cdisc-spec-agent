# LLM provider: anthropic | openai | mock (mock = offline heuristics, no key needed)
SPECFORGE_LLM=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# SPECFORGE_MODEL=claude-sonnet-4-5
# Set to 0 to never send sample data values to the LLM (only column names / types)
SPECFORGE_SHARE_SAMPLES=1
SPECFORGE_MAX_REPAIRS=3
# SPECFORGE_EMBEDDINGS=st   # use sentence-transformers instead of the built-in hashing embedder
